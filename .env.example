# Supabase
# Public - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only - never expose to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Resend (contact-form notifications to Yael)
RESEND_API_KEY=
# Verified sender in Resend (e.g. onboarding@resend.dev or noreply@yaelifestyle.co.il)
RESEND_FROM_EMAIL=
# Optional fallback if business profile email is empty
CONTACT_NOTIFICATION_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=

# Google
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
